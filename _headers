# Custom headers for Cloudflare Workers static assets.
# Kept at project root: @sveltejs/adapter-cloudflare picks it up
# and includes it in the Workers build output.
# https://developers.cloudflare.com/workers/static-assets/headers/

# Security headers for all routes
/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(self), camera=(), microphone=(), payment=(), usb=()
  X-XSS-Protection: 1; mode=block
  Content-Security-Policy: default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; img-src 'self' data: blob: https://tiles.openfreemap.org https://mapservices.weather.noaa.gov; connect-src 'self' https://api.weather.gov https://tiles.openfreemap.org https://mapservices.weather.noaa.gov https://geocoding.geo.census.gov; style-src 'self' 'unsafe-inline' https://tiles.openfreemap.org; font-src 'self' data:; script-src 'self' 'wasm-unsafe-eval'; worker-src 'self' blob:; manifest-src 'self'

# Hashed SvelteKit build output - safe to cache long-term
/_app/immutable/*
  Cache-Control: public, max-age=31536000, immutable

# HTML app shell should always be revalidated
/*.html
  Cache-Control: public, max-age=0, must-revalidate

# Web manifest changes must propagate quickly for installability
/site.webmanifest
  Cache-Control: public, max-age=3600, must-revalidate

# Service worker must never be cached - otherwise updates get stuck
/service-worker.js
  Cache-Control: public, max-age=0, must-revalidate

{
  "extends": "$app/tsconfig",
  "compilerOptions": {
    "rewriteRelativeImportExtensions": true,
    "checkJs": false,
    "sourceMap": true,
    "strict": true
  },
  "exclude": [
    "node_modules/**",
    ".svelte-kit/output/**",
    ".svelte-kit/cloudflare/**",
    ".svelte-kit/cloudflare-tmp/**",
    ".wrangler/**",
    "build/**",
    "src/service-worker.js",
    "src/service-worker/**/*.js",
    "src/service-worker.ts",
    "src/service-worker/**/*.ts",
    "src/service-worker.d.ts",
    "src/service-worker/**/*.d.ts"
  ],
  "include": [
    "src"
  ]
}

{
  "name": "swa",
  "private": true,
  "version": "0.0.1",
  "license": "AGPL-3.0-only",
  "type": "module",
  "packageManager": "pnpm@12.14.0",
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "dev": "vite dev",
    "build": "vite build",
    "preview": "pnpm run build && wrangler dev",
    "prepare": "svelte-kit sync || echo ''",
    "paraglide": "paraglide-js compile --project ./project.inlang --outdir ./src/lib/paraglide --strategy cookie localStorage baseLocale --emit-ts-declarations",
    "precheck": "pnpm run paraglide",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "deploy": "pnpm run build && wrangler deploy",
    "cf-typegen": "wrangler types src/worker-configuration.d.ts"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@inlang/paraglide-js": "2.29.0",
    "@sveltejs/adapter-cloudflare": "8.0.1",
    "@sveltejs/kit": "3.1.0",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "26.6.5",
    "@vitest/coverage-v8": "5.0.5",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-svelte": "3.23.1",
    "globals": "17.13.0",
    "picomatch": "4.0.7",
    "prettier": "3.9.10",
    "prettier-plugin-svelte": "4.1.1",
    "prettier-plugin-tailwindcss": "0.8.1",
    "svelte": "5.57.2",
    "svelte-check": "4.7.7",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vite": "8.3.4",
    "vitest": "5.0.5",
    "wrangler": "4.151.1"
  },
  "dependencies": {
    "chart.js": "4.5.1",
    "maplibre-gl": "6.15.0",
    "openmeteo": "1.2.3"
  },
  "overrides": {
    "cookie": "2.0.1"
  },
  "imports": {
    "#lib": "./src/lib/index.js",
    "#lib/*": "./src/lib/*"
  }
}
